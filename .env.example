# 볼트 위치 (관리자 화면·내보내기만 읽는다. 사용자 화면은 data/public/만 읽는다)
HIVE_VAULT=/Users/drone_engineer/cursor/claude_code_test
# 사용자 화면 주소 (관리자 화면의 "사용자 화면" 링크)
HIVE_PUBLIC_URL=http://127.0.0.1:8010

# 지식기반 답변 — console.anthropic.com에서 만든 API 키. 비워 두면 답변 대신 관련 문서만 보여 준다.
ANTHROPIC_API_KEY=
HIVE_MODEL=claude-opus-5-5
HIVE_EFFORT=medium
ASK_PER_HOUR=20
ASK_PER_DAY=300

# 관리자 화면을 터널(휴대폰 등)로 열 때 필요한 비밀번호. 비어 있으면 외부 접속을 막는다.
ADMIN_PASSWORD=
